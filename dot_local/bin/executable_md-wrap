#!/usr/bin/env bash
# md-wrap — find and unwrap hard-wrapped prose in markdown files.
#
# Hard wrapping (breaking a paragraph at a fixed column) costs the same bytes as
# one line per paragraph, renders as visible line breaks in Obsidian when
# "Strict line breaks" is off, and makes every edit re-flow lines that didn't
# change. This finds it and undoes it.
#
# Usage:
#   md-wrap check [paths...]        Report files with hard-wrapped paragraphs
#   md-wrap diff  [paths...]        Show what fix would change; write nothing
#   md-wrap fix   [paths...]        Rewrite in place: one line per paragraph
#
# Paths may be files, directories (searched recursively for *.md), or globs.
# Defaults to the current directory.
#
# Options:
#   --min N     Shortest line that counts as wrapped (default 40)
#   --max N     Longest  line that counts as wrapped (default 100)
#   --exclude G Skip paths matching glob G; repeatable. Generated or vendored
#               trees are the usual case: --exclude '*/generated/*'
#   --color W   always | never | auto (default). auto colours diff output when
#               stdout is a terminal and NO_COLOR is unset. Uses GNU diff's own
#               --color, else delta, colordiff or bat, whichever is installed.
#   -q          check: print only the file list, no counts
#
# A paragraph is hard-wrapped when it spans 2+ lines and every line but the last
# is between --min and --max characters. Frontmatter, fenced code, tables,
# headings, blockquotes, indented blocks and explicit markdown line breaks (two
# trailing spaces, or a trailing backslash) are left untouched.
#
# A list item is one paragraph: its continuations join back onto the marker
# line, and a nested item joins onto its own marker rather than its parent's.
#
# Exit status: 0 clean, 1 hard wrapping found (check/diff), 2 usage error.

set -euo pipefail

MIN=40
MAX=100
QUIET=0
COLOR=auto
MODE=""
PATHS=()
EXCLUDES=()

usage() { sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
  case "$1" in
    check|diff|fix) MODE="$1"; shift ;;
    --min) MIN="${2:?--min needs a number}"; shift 2 ;;
    --max) MAX="${2:?--max needs a number}"; shift 2 ;;
    --exclude) EXCLUDES+=("${2:?--exclude needs a glob}"); shift 2 ;;
    --color) COLOR="${2:?--color needs always|never|auto}"; shift 2 ;;
    -q|--quiet) QUIET=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; PATHS+=("$@"); break ;;
    -*) echo "md-wrap: unknown option $1" >&2; exit 2 ;;
    *) PATHS+=("$1"); shift ;;
  esac
done

[ -n "$MODE" ] || { usage; exit 2; }
[ "${#PATHS[@]}" -gt 0 ] || PATHS=(.)

excluded() {
  local f="$1" g
  for g in ${EXCLUDES+"${EXCLUDES[@]}"}; do
    # shellcheck disable=SC2053
    [[ "$f" == $g ]] && return 0
  done
  return 1
}

# Collect the file list: directories are searched recursively, everything else
# is taken as given so shell globs and explicit filenames both work.
FILES=()
for p in "${PATHS[@]}"; do
  if [ -d "$p" ]; then
    while IFS= read -r f; do
      excluded "$f" || FILES+=("$f")
    done < <(
      find "$p" -type f -name '*.md' \
        -not -path '*/.git/*' -not -path '*/node_modules/*' | sort
    )
  elif [ -f "$p" ]; then
    excluded "$p" || FILES+=("$p")
  fi
done

[ "${#FILES[@]}" -gt 0 ] || { echo "md-wrap: no markdown files found" >&2; exit 2; }

# Colour, decided once. auto defers to the terminal and to NO_COLOR; GNU diff
# colours its own output, otherwise pipe through whichever tool is installed.
case "$COLOR" in
  always) want_color=1 ;;
  never)  want_color=0 ;;
  auto)   { [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; } && want_color=1 || want_color=0 ;;
  *) echo "md-wrap: --color takes always, never or auto" >&2; exit 2 ;;
esac

DIFF_OPTS=()
DIFF_PIPE=""
if [ "$want_color" -eq 1 ]; then
  if diff --color=always -u /dev/null /dev/null >/dev/null 2>&1; then
    DIFF_OPTS=(--color=always)
  elif command -v delta >/dev/null 2>&1; then DIFF_PIPE="delta"
  elif command -v colordiff >/dev/null 2>&1; then DIFF_PIPE="colordiff"
  elif command -v bat >/dev/null 2>&1; then
    DIFF_PIPE="bat -l diff --color=always --style=plain --paging=never"
  fi
fi

show_diff() {  # $1 file on disk, $2 reflowed copy
  if [ -n "$DIFF_PIPE" ]; then
    diff -u --label "$1" --label "$1 (reflowed)" "$1" "$2" | $DIFF_PIPE || true
  else
    diff ${DIFF_OPTS+"${DIFF_OPTS[@]}"} -u \
      --label "$1" --label "$1 (reflowed)" "$1" "$2" || true
  fi
}

# One classifier, shared by every mode. Buffers the file, reflows the paragraphs
# it judges hard-wrapped, and reports the count on stderr as "<n> <maxcol>".
reflow() {
  # LC_ALL=C pins awk to bytes so the character count below is deterministic:
  # BSD awk's length() counts bytes whatever the locale says, and every line
  # holding an em dash or a curly quote would otherwise measure over the limit
  # and be passed over. Every pattern here is ASCII, and awk stays byte
  # transparent, so nothing else changes.
  LC_ALL=C awk -v MIN="$MIN" -v MAX="$MAX" '
    # Characters, not bytes: drop the UTF-8 continuation bytes from the count.
    function ulen(s,   t, c) { t = s; c = gsub(/[\200-\277]/, "", t); return length(s) - c }
    # Leading whitespace of a line, "" when it starts in column 1.
    function indent(s,   t) { t = s; sub(/[^ \t].*$/, "", t); return t }
    function indlen(s) { return length(indent(s)) }
    function flush(   i, ok, m, joined, body, ind, first) {
      if (n == 0) return
      ok = (n >= 2)
      m = 0
      # Every line has to sit at one indent: a change of indent is a change of
      # structure, not a wrap. A list item sets its own on the marker line, so
      # there the rule starts from the first continuation instead.
      first = lmark ? 2 : 1
      if (ok && n >= first) {
        ind = indent(P[first])
        for (i = first; ok && i <= n; i++) if (indent(P[i]) != ind) ok = 0
      }
      for (i = 1; ok && i < n; i++) {
        if (ulen(P[i]) < MIN || ulen(P[i]) > MAX || BRK[i]) ok = 0
        else if (ulen(P[i]) > m) m = ulen(P[i])
      }
      if (ok) {
        # Keep the block indent once, on the joined line; every continuation
        # sheds its own, or it lands as a run of spaces mid-sentence.
        joined = P[1]
        for (i = 2; i <= n; i++) {
          body = P[i]
          sub(/^[ \t]+/, "", body)
          joined = joined " " body
        }
        print joined
        wrapped++
        if (m > col) col = m
      } else {
        for (i = 1; i <= n; i++) print P[i]
      }
      n = 0; lmark = 0; lind = 0
    }
    BEGIN { fm = 0; fence = 0; n = 0; wrapped = 0; col = 0; lmark = 0; lind = 0 }
    NR == 1 && $0 == "---" { fm = 1; print; next }
    fm { if ($0 == "---") fm = 0; print; next }
    /^[ \t]*(```|~~~)/ { fence = !fence; flush(); print; next }
    fence { print; next }
    /^[ \t]*$/ { flush(); print; next }
    # Block constructs that own their own line breaks. A marker only counts
    # when whitespace follows it, so *emphasis* opening a line stays prose.
    /^[ \t]*#{1,6}([ \t]|$)/ { flush(); print; next }
    /^[ \t]*[|>]/ { flush(); print; next }
    # Thematic break and setext underline, before the list rule can claim them.
    /^[ \t]*(=+|-+|([-*_][ \t]*){3,})[ \t]*$/ { flush(); print; next }
    # A list marker opens a block rather than ending one: the item text wraps
    # onto its continuations, so the marker line is line 1 of the paragraph.
    /^[ \t]*([-*+]|[0-9]+[.)])[ \t]/ {
      flush()
      n = 1; P[1] = $0; BRK[1] = ($0 ~ /(  +|\\)$/)
      lmark = 1; lind = indlen($0)
      next
    }
    /^[ \t]*</ { flush(); print; next }
    {
      # Inside a list item, a line that dedents to the marker or indents a
      # further four leaves the item: the first is the next block, the second
      # is a code block nested under it.
      if (lmark && (indlen($0) <= lind || indlen($0) >= lind + 4)) flush()
      if (!lmark && $0 ~ /^([ ]{4,}|\t)/) { flush(); print; next }
      n++
      P[n] = $0
      # Explicit markdown line break: two trailing spaces, or a trailing backslash.
      BRK[n] = ($0 ~ /(  +|\\)$/)
    }
    END { flush(); printf "%d %d\n", wrapped, col > "/dev/stderr" }
  ' "$1"
}

status=0
total=0

for f in "${FILES[@]}"; do
  tmp="$(mktemp)"
  # stderr carries the count; stdout carries the reflowed file.
  counts="$(reflow "$f" 2>&1 >"$tmp" || true)"
  # shellcheck disable=SC2086  # deliberate split of "<wrapped> <maxcol>"
  set -- $counts
  wrapped="${1:-0}"
  col="${2:-0}"

  if [ "$wrapped" -eq 0 ]; then rm -f "$tmp"; continue; fi

  status=1
  total=$((total + wrapped))

  case "$MODE" in
    check)
      if [ "$QUIET" -eq 1 ]; then echo "$f"
      else printf '%5d paragraph(s)  wrapped at <=%3d  %s\n' "$wrapped" "$col" "$f"
      fi
      rm -f "$tmp"
      ;;
    diff)
      printf '\n=== %d paragraph(s), wrapped at <=%d\n' "$wrapped" "$col"
      show_diff "$f" "$tmp"
      rm -f "$tmp"
      ;;
    fix)
      cat "$tmp" >"$f"
      rm -f "$tmp"
      printf 'unwrapped %5d paragraph(s)  %s\n' "$wrapped" "$f"
      ;;
  esac
done

if [ "$status" -eq 0 ]; then
  echo "md-wrap: no hard-wrapped paragraphs in ${#FILES[@]} file(s)"
else
  printf 'md-wrap: %d paragraph(s) across %d file(s) scanned\n' "$total" "${#FILES[@]}" >&2
fi

# fix always succeeds; check and diff report the finding through exit status.
[ "$MODE" = "fix" ] && exit 0
exit "$status"
