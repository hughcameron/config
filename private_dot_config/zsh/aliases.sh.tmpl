# Aliases

# Chezmoi
alias cm='chezmoi'
alias cmts='cm-target-to-source'
alias cmup='cm-source-update'

# Homebrew
alias brewup='brew upgrade'

# Git
alias lg='lazygit'
alias gl='gh pr list'
alias gv='gh pr view'
# gs (ready + squash merge) is a function — see functions.zsh

# Claude (use claude-session when you want the tmux wrap)
{{ if eq .chezmoi.os "darwin" -}}
alias cc='claude --permission-mode auto'
{{ else -}}
alias cc='claude --dangerously-skip-permissions'
{{ end }}
# Navi
alias n='navi'

# Pipeline
alias pl='navi --query "pipeline" --best-match'

{{ if eq .chezmoi.os "darwin" -}}
# Remote sessions
alias bb='ssh beelink'
alias bba='navi --query "attach to existing tmux" --best-match'
alias bbs='navi --query "claude-session in zoxide-tracked project" --best-match'
alias bbts='ssh beelink-ts'
alias bbt='navi --query "attach to existing tmux (Tailscale)" --best-match'

# Finder / Terminal
alias peek='open .'
alias tap='open -a Terminal'

# Bear CLI
alias br='bcli'

# Msgvault
alias em='msgvault'

# Nushell analysis scripts (kept as nu invocations)
alias bt='nu ~/.config/analysis/brewtrend/brewtrend.nu'
alias gcpvm='nu ~/.config/nushell/scripts/gcpvm.nu'
# Claude usage analytics (ported to bash — no nushell dependency)
alias ccu='bash ~/.config/analysis/claude-usage/claude-usage.sh'
# ccusage npm CLI, run on demand (no global install; same as ccu uses internally)
alias ccusage='bunx ccusage@latest'

# DuckDB — load highlight colours explicitly rather than from ~/.duckdbrc.
# duckdb prints "-- Loading resources from <file>" on stderr whenever it loads
# an init file, and yazi's duckdb preloader treats any stderr as a failed
# preview: it deletes the parquet cache it just wrote and re-runs forever.
# Keeping the colours off the default path means yazi's duckdb (spawned
# directly, so no alias applies) sees empty stderr, while shells get colour.
alias duckdb='duckdb -init ~/.config/duckdb/colors.sql'

# DuckDB via navi
alias dx='navi --query "duckdb -f <file>" --best-match'
alias dv='navi --query "duckdb -json -f <file> | vd -f json" --best-match'
alias dj='navi --query "duckdb -json -f <file> | jless" --best-match'

# Hybrid retrieval over an Obsidian vault (obsidian-hybrid-search, installed via
# `bun install -g`, so it is version-pinned and on PATH rather than a git checkout).
#   ohs    the raw engine. UNSCOPED — it will return session transcripts.
#          Needs OBSIDIAN_VAULT_PATH, or run it from inside a vault.
#   brain  the same engine scoped to the governing layer of the planning vault,
#          with its index kept outside the vault so it never reaches Obsidian Sync.
#          Resolves its own vault and index, so it works from any directory.
# MERIDIAN_VAULT is set in secrets.sh, not here — this repo is public.
alias ohs='obsidian-hybrid-search'
alias brain='python3 "$MERIDIAN_VAULT/tools/brain-query.py"'
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
alias ci='curl -fsSL https://claude.ai/install.sh | bash'
{{ end -}}
