-- DuckDB plugin configuration.
-- cache_size caps how many rows a preview reads. It reaches the summarize pass
-- only because of a local patch in plugins/duckdb.yazi/main.lua -- upstream
-- summarizes the whole file regardless, so every preload paid a full scan.
-- mode: open on the data. The plugin defaults to "summarized" (one row per
-- column: type, min, max, avg, null%). `g t` flips between the two.
require("duckdb"):setup {
	mode = "standard",
	cache_size = 1000,
}

require("full-border"):setup()

require("git"):setup {
	-- Order of status signs showing in the linemode
	order = 1500,
}

-- Bookmark manager
require("yamb"):setup {
	-- Use default bookmark storage (persistent across sessions)
}


-- Disk usage in header (Linux only, uses df)
require("fs-usage"):setup()

{{- if eq .chezmoi.os "darwin" }}
-- GCS browser: header indicator, auto-populate, preview, download (macOS only)
require("gcs-browser"):setup({
	gcloud_path = "/opt/homebrew/bin/gcloud",
})
{{- end }}

