% markdown, md-wrap, hard wrapping, prose, reflow

# Check a directory for hard-wrapped prose (recursive; exit 1 if any found)
md-wrap check <path>

# Check a single file
md-wrap check <file>

# Check, skipping a generated or vendored tree
md-wrap check <path> --exclude '<exclude_pattern>'

# List the offending files only, no counts (pipes into other commands)
md-wrap check <path> -q

# Preview the reflow as a unified diff, writing nothing
md-wrap diff <path>

# Preview the reflow for one file
md-wrap diff <file>

# Preview in colour through a pager (colour is automatic on a terminal)
md-wrap diff <path> --color always | less -R

# Unwrap in place: one line per paragraph
md-wrap fix <path>

# Unwrap one file in place
md-wrap fix <file>

# Treat a different wrap column as hard wrapping (default 40-100)
md-wrap check <path> --min <min_col> --max <max_col>

$ path: ls -d */ 2>/dev/null; echo .
$ file: fd -e md --max-depth 3 2>/dev/null || find . -maxdepth 3 -name '*.md' -not -path '*/.git/*'
$ exclude_pattern: printf '%s\n' '*/generated/*' '*/vendor/*' '*/node_modules/*' '*/build/*' '*/.venv/*'
$ min_col: printf '%s\n' 40 50 60 72
$ max_col: printf '%s\n' 72 80 100 120
